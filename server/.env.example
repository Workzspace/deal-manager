# Copy this file to ".env" and change the values before running in production.

# Port the API server listens on
PORT=4000

# Secret used to sign login tokens (JWT). Make this a long random string.
JWT_SECRET=change-me-to-a-long-random-secret-string

# The shared login password for the business.
# Everyone in the family who should access the app uses this password.
APP_PASSWORD=family123
