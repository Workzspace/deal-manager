# Copy this file to ".env" and change the values before running in production.

# Port the API server listens on (local dev only)
PORT=4000

# Secret used to sign login tokens (JWT). Make this a long random string.
JWT_SECRET=change-me-to-a-long-random-secret-string

# The shared 4-digit login PIN for the business.
APP_PASSWORD=2561

# PostgreSQL connection string (from Supabase → Connect → Session pooler URI).
# Leave this BLANK to run locally on a temporary in-memory database (not saved).
# Set it to save data and sync across devices. See DEPLOY.md.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
